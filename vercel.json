{
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "includeFiles": "app/**,static/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/static/uploads/(.*)",
      "destination": "/api/index.py?__vercel_path=/static/uploads/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index.py?__vercel_path=/static/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__vercel_path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/ai-blog/cron-run",
      "schedule": "0 * * * *"
    }
  ]
}
